# Global Ghost Net (Vantablack) Configuration
# -------------------------------------------------------------
# Zero-VPS Friction-Free Peer Discovery Configuration

# 1. Cloudflare DNS Seed (Free):
# Point a DNS A or AAAA record (e.g. seeds.yourdomain.com) in Cloudflare (DNS-only / Grey Cloud)
# to one or more known public IP addresses of community seed / exit nodes.
# When a client boots up, it queries this domain, discovers alive peers, and caches them to peers.cache.
# GHOST_DNS_SEED=seeds.yourdomain.com:2270

# 2. Manual bootstrap seed nodes (comma-separated IP:PORT)
# GHOST_SEEDS=127.0.0.1:12001

# 3. Local Listen Port (default 2270)
GHOST_LISTEN_PORT=2270

# 4. SOCKS5 Proxy Port for applications (curl, browsers, etc.)
GHOST_SOCKS5_PORT=1080

# 5. Exit Node Settings (set to "any" on exit nodes, comment out on client nodes)
# GHOST_EXIT_ALLOWLIST=any
# Require a signed EXITAUTH voucher on every exit request (default off for compatibility)
# GHOST_EXIT_REQUIRE_VOUCHER=1
# Client-side hex voucher emitted by EXITVOUCHER on the exit node
# GHOST_EXIT_VOUCHER=<hex>

# 6. Control center / desktop shell
# Headless Linux/server mode: use --no-default-features or GHOST_NO_GUI=1.
# GHOST_NO_GUI=1
# GHOST_WEB_BIND=127.0.0.1
# GHOST_WEB_PORT=2270
# GHOST_LOG=%APPDATA%\\GlobalGhostNet\\ghost.log

# 7. VPN mode
# GHOST_VPN=hub|client
# GHOST_VPN_FAKE_TUN=1       # privilege-free development/CI path
# GHOST_VPN_DNS=10.66.0.1
# GHOST_VPN_SEARCH=home.arpa
# GHOST_VPN_LOCAL_IP=10.66.0.10
# GHOST_VPN_CLIENTS=<comma-separated fingerprints>
# GHOST_VPN_HUB_FP=<hub fingerprint>
# GHOST_VPN_LAN_SUBNET=192.168.1.0/24

# 8. Hardware-backed identity (optional feature builds)
# GHOST_PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
# GHOST_PKCS11_SLOT=0
# Never put a production PIN in a checked-in file; inject it through the process environment.
# GHOST_PKCS11_PIN=<secret>
# TPM device probing uses /dev/tpmrm0, /dev/tpm0, or Windows TBS when hardware-tpm is enabled.

# 9. Uniform handshake experiment (§2, opt-in; both peers must enable it)
# Removes fixed handshake/response magic and uses authenticated random prefixes.
# This is a compatibility spike, not yet a complete pluggable-transport claim.
# GHOST_HANDSHAKE_UNIFORM=1

# 10. ShardSec per-shard authenticated encryption (versioned GTF path)
# Enable only when all peers in the compatibility domain support FLAG_SHARDSEC.
# GHOST_SHARDSEC=1

# 11. Logging verbosity
RUST_LOG=info
