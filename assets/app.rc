// Windows resources for the Global Ghost Net application binaries.
//
// Two things live here that a user only sees through the shell, never at
// runtime:
//
//   1. The application icon. Without it Explorer shows the generic .exe glyph
//      and the taskbar has nothing to group the window under. (The *running*
//      window's icon comes from src/ghost/icon.rs, which uses the small
//      icon-ui.ico embedded in the binary.)
//   2. A version block, so the Properties dialog shows a product name and a
//      version instead of blank fields.
//
// Compiled by build.rs through embed-resource (rc.exe / windres). Icon indices
// are positional: 1 is the lowest application icon ID, which is what the shell
// picks up by default. No windows.h is included, so the symbolic constants are
// spelled as the literals they expand to.

1 ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,1,0
 PRODUCTVERSION 0,4,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Global Ghost Net"
            VALUE "FileDescription", "Global Ghost Net"
            VALUE "FileVersion", "0.4.1"
            VALUE "InternalName", "ggn"
            VALUE "OriginalFilename", "ggn.exe"
            VALUE "ProductName", "Global Ghost Net"
            VALUE "ProductVersion", "0.4.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
