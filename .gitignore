target/
node_modules/
# Runtime-generated Ed25519 node identity (L0). Auto-created on first run;
# never commit a private signing key.
identity.key
identity_*.key
# Runtime state written into the working directory by a running node:
# `peers.cache` every 60 s, plus revocation / topology dumps on demand.
# Operational state, not source.
peers.cache
revocations.json
ghost-topology.json
# Consumer control-plane state written by the Web Control Center:
# device names, egress mode and split-tunnel bypass rules.
ghost-consumer.json
ghost-consumer.json.tmp
# Desktop-build log mirror (the GUI process has no console on Windows).
ghost.log
