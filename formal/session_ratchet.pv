(*
   Vantablack SessionRatchet — Forward Secrecy (FS) & Post-Compromise Security (PCS)
   (ProVerif 2.05 symbolic model)

   Models `src/ghost/session/ratchet.rs` + `src/ghost/layers/l1_kem.rs`:

   1. Forward Secrecy (symmetric chain `kdf_ck`):
      - Epoch 0 seals `m0_fs` under `kdf_mk(ck0)` and immediately steps the chain
        to `ck1 = kdf_ck_next(ck0)`, discarding `ck0` and `kdf_mk(ck0)`.
      - The adversary is explicitly given `ck1` on the public channel `c`.
      - Query `attacker(m0_fs)` checks that `ck1` cannot recover epoch 0's plaintext.

   2. Post-Compromise Security / Break-in Recovery (hybrid DH + ML-KEM ratchet `kdf_rk_hybrid`):
      - Both `rk1` and `ck1` are explicitly leaked to the adversary on `c`.
      - Peers then perform an authenticated epoch-2 hybrid ratchet step using a fresh
        classical Diffie-Hellman share and a fresh ML-KEM encapsulation, deriving
        `rk2 = kdf_rk_hybrid(rk1, hcat(dh_ss2, pq_ss2))` and `ck2 = kdf_ck_from_rk(rk2)`.
      - Epoch 2 seals `m2_pcs` under `kdf_mk(ck2)`.
      - Query `attacker(m2_pcs)` checks that compromising `(rk1, ck1)` does not
        compromise epoch 2 after the authenticated hybrid ratchet completes.
*)

free c: channel.

type skey.
type pkey.
type pqsk.
type pqpk.
type sig.

fun pk(skey): pkey.
fun sign(bitstring, skey): sig.
reduc forall m: bitstring, s: skey; verify(sign(m, s), pk(s)) = m.

fun pkpq(pqsk): pqpk.
fun dh(bitstring, bitstring): bitstring.

fun encaps_pq(pqpk, bitstring): bitstring.
reduc forall sk: pqsk, r: bitstring; decaps_pq(sk, encaps_pq(pkpq(sk), r)) = r.

fun hcat(bitstring, bitstring): bitstring.
fun kdf_mk(skey): skey.
fun kdf_ck_next(skey): skey.
fun kdf_rk_hybrid(skey, bitstring): skey.
fun kdf_ck_from_rk(skey): skey.

fun senc(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; sdec(senc(m, k), k) = m.

free g: bitstring.

free m0_fs: bitstring [private].
free m2_pcs: bitstring [private].

query attacker(m0_fs).
query attacker(m2_pcs).

let ratchet_peer =
  new skA: skey;
  new skB: skey;
  new rk0: skey;
  new ck0: skey;
  out(c, pk(skA));
  out(c, pk(skB));

  (* Epoch 0: seal m0_fs, step symmetric chain, discard ck0 *)
  let mk0 = kdf_mk(ck0) in
  out(c, senc(m0_fs, mk0));
  let ck1 = kdf_ck_next(ck0) in
  let rk1 = rk0 in

  (* Explicit compromise of epoch-1 state on the untrusted channel *)
  out(c, rk1);
  out(c, ck1);

  (* Epoch 2: authenticated hybrid ratchet step *)
  new ra2: bitstring;
  new rb2: bitstring;
  new skPQ2: pqsk;
  new ephPQ2: bitstring;
  let ga2 = dh(ra2, g) in
  let gb2 = dh(rb2, g) in
  let pq_pub2 = pkpq(skPQ2) in
  out(c, ga2);
  out(c, gb2);
  out(c, pq_pub2);
  out(c, sign((ga2, gb2, pq_pub2), skA));
  in(c, sig_a: sig);
  let checked = verify(sig_a, pk(skA)) in
  if checked = (ga2, gb2, pq_pub2) then
  let klass2 = dh(ra2, gb2) in
  let pq_sec2 = decaps_pq(skPQ2, encaps_pq(pq_pub2, ephPQ2)) in
  let rk2 = kdf_rk_hybrid(rk1, hcat(klass2, pq_sec2)) in
  let ck2 = kdf_ck_from_rk(rk2) in
  let mk2 = kdf_mk(ck2) in
  out(c, senc(m2_pcs, mk2)).

process
  (!ratchet_peer)
